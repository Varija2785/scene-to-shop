st.title("🛍️ Scene-to-Shop")
st.subheader(
    "Select anything you want to shop for"
)
st.write(
    "Upload a scene, select an object, "
    "and let AI understand it."
)
uploaded_file = st.file_uploader(
    "Upload an image",
    type=["jpg", "jpeg", "png"],
    key="scene_upload"
)
if uploaded_file:
    image = Image.open(
        uploaded_file
    ).convert("RGB")
    st.markdown(
        "### 1. Select the object"
    )
    st.info(
        "Draw a rectangle around the object. "
        "It does not need to be perfect."
    )
    canvas_width = min(
        1000,
        image.width
    )
    scale = canvas_width / image.width
    canvas_height = int(
        image.height * scale
    )
    display_image = image.resize(
        (
            canvas_width,
            canvas_height
        )
    )
    canvas_result = st_canvas(
        fill_color="rgba(0, 200, 255, 0.20)",
        stroke_width=4,
        stroke_color="#00AEEF",
        background_image=display_image,
        update_streamlit=True,
        height=canvas_height,
        width=canvas_width,
        drawing_mode="rect",
        key="object_selector"
    )
    col1, col2 = st.columns(2)
    with col1:
        understand_clicked = st.button(
            "🔍 Understand Object",
            type="primary",
            use_container_width=True
        )
    with col2:
        retry_selection_clicked = st.button(
            "↩ Retry Selection",
            use_container_width=True
        )
    if retry_selection_clicked:
        reset_selection()
        st.rerun()
    if understand_clicked:
        if canvas_result.json_data is None:
            st.warning(
                "Please draw a rectangle around an object first."
            )
        else:
            objects = canvas_result.json_data.get(
                "objects",
                []
            )
            if not objects:
                st.warning(
                    "Please draw a rectangle around an object first."
                )
            else:
                rect = objects[-1]
                left = rect.get(
                    "left",
                    0
                )
                top = rect.get(
                    "top",
                    0
                )
                width = rect.get(
                    "width",
                    0
                )
                height = rect.get(
                    "height",
                    0
                )
                if width < 15 or height < 15:
                    st.warning(
                        "The selected area is too small."
                    )
                else:
                    scale_x = (
                        image.width /
                        canvas_width
                    )
                    scale_y = (
                        image.height /
                        canvas_height
                    )
                    x1 = max(
                        0,
                        int(left * scale_x)
                    )
                    y1 = max(
                        0,
                        int(top * scale_y)
                    )
                    x2 = min(
                        image.width,
                        int(
                            (left + width)
                            * scale_x
                        )
                    )
                    y2 = min(
                        image.height,
                        int(
                            (top + height)
                            * scale_y
                        )
                    )
                    # Add padding around the selected object.
                    # This prevents tiny selections from producing
                    # extremely small crops such as 69x80 pixels.
                    box_width = x2 - x1
                    box_height = y2 - y1
                    padding_x = int(box_width * 0.15)
                    padding_y = int(box_height * 0.15)
                    crop_x1 = max(0, x1 - padding_x)
                    crop_y1 = max(0, y1 - padding_y)
                    crop_x2 = min(image.width, x2 + padding_x)
                    crop_y2 = min(image.height, y2 + padding_y)
                    selected = image.crop(
                        (
                            crop_x1,
                            crop_y1,
                            crop_x2,
                            crop_y2
                        )
                    )
                    output_path = (
                        OUTPUT_DIR /
                        "selected_object.jpg"
                    )
                    selected.save(
                        output_path,
                        quality=95
                    )
                    st.session_state[
                        "selected_object"
                    ] = selected
                    clear_analysis()
                    with st.spinner(
                        "AI is understanding the selected object..."
                    ):
                        result = analyze_object(
                            selected
                        )
                    if "error" in result:
                        st.session_state[
                            "analysis_error"
                        ] = result["error"]
                    else:
                        save_analysis(
                            result
                        )
    # --------------------------------------------------
    # SELECTED OBJECT RESULT
    # --------------------------------------------------
    if "selected_object" in st.session_state:
        st.markdown("---")
        st.markdown(
            "### 2. AI Understanding"
        )
        selected_object = (
            st.session_state[
                "selected_object"
            ]
        )
        col1, col2 = st.columns(
            [1, 1]
        )
        with col1:
            st.image(
                selected_object,
                caption="Selected object",
                use_container_width=True
            )
        with col2:
            # -----------------------------
            # ERROR STATE
            # -----------------------------
            if "analysis_error" in st.session_state:
                st.warning(
                    "⚠️ AI understanding is temporarily unavailable."
                )
                st.write(
                    st.session_state[
                        "analysis_error"
                    ]
                )
                retry_ai_clicked = st.button(
                    "🔄 Retry AI Analysis",
                    type="primary",
                    use_container_width=True
                )
                if retry_ai_clicked:
                    clear_analysis()
                    with st.spinner(
                        "Trying AI analysis again..."
                    ):
                        result = analyze_object(
                            selected_object
                        )
                    if "error" in result:
                        st.session_state[
                            "analysis_error"
                        ] = result["error"]
                    else:
                        save_analysis(
                            result
                        )
                    st.rerun()
            # -----------------------------
            # SUCCESS STATE
            # -----------------------------
            elif "object_name" in st.session_state:
                object_name = (
                    st.session_state[
                        "object_name"
                    ]
                )
                description = (
                    st.session_state[
                        "description"
                    ]
                )
                confidence = (
                    st.session_state[
                        "confidence"
                    ]
                )
                shopping_relevant = (
                    st.session_state[
                        "shopping_relevant"
                    ]
                )
                st.success(
                    f"**{object_name}**"
                )
                st.write(
                    description
                )
                st.write(
                    f"AI confidence: "
                    f"**{confidence * 100:.1f}%**"
                )
                if shopping_relevant:
                    st.success(
                        "? Suitable for visual shopping"
                    )
                    find_products_clicked = st.button(
                        "Find Similar Products",
                        type="primary",
                        use_container_width=True
                    )
                    if find_products_clicked:
                        if not SERPAPI_API_KEY:
                            st.error(
                                "SERPAPI_API_KEY is not configured in .env"
                            )
                        else:
                            with st.spinner(
                                "?? Searching for visually similar products..."
                            ):
                                search_result = search_google_lens(
                                    OUTPUT_DIR / "selected_object.jpg",
                                    SERPAPI_API_KEY,
                                    max_results=12
                                )
                                if not search_result.get("error"):
                                    products = search_result.get(
                                        "results",
                                        []
                                    )
                                    if products:
                                        products = rank_products(
                                            selected_object,
                                            products,
                                            max_products=12
                                        )
                                        search_result["results"] = products
                            if search_result.get("error"):
                                st.error(
                                    search_result["error"]
                                )
                            else:
                                products = search_result.get(
                                    "results",
                                    []
                                )
                                if not products:
                                    st.warning(
                                        "No visual product matches were found."
                                    )
                                else:
                                    st.markdown(
                                        "### Similar Products"
                                    )
                                    for product in products:
                                        title = product.get(
                                            "title",
                                            "Untitled product"
                                        )
                                        source = product.get(
                                            "source",
                                            ""
                                        )
                                        thumbnail = product.get(
                                            "thumbnail",
                                            ""
                                        )
                                        link = product.get(
                                            "link",
                                            ""
                                        )
                                        price = product.get(
                                            "price",
                                            ""
                                        )
                                        currency = product.get(
                                            "currency",
                                            ""
                                        )
                                        col_img, col_info = st.columns(
                                            [1, 2]
                                        )
                                        with col_img:
                                            if thumbnail:
                                                st.image(
                                                    thumbnail,
                                                    use_container_width=True
                                                )
                                        with col_info:
                                            st.markdown(
                                                f"**{title}**"
                                            )
                                            if source:
                                                st.caption(source)
                                            visual_similarity = product.get(
                                                "visual_similarity"
                                            )
                                            if visual_similarity is not None:
                                                st.caption(
                                                    "Image similarity score: "
                                                    f"{visual_similarity:.3f} "
                                                    "(comparative score, not a probability)"
                                                )
                                            title_similarity = product.get(
                                                "title_similarity"
                                            )
                                            if title_similarity is not None:
                                                st.caption(
                                                    "Title relevance score: "
                                                    f"{title_similarity:.3f}"
                                                )
                                            relevance = product.get(
                                                "relevance_score"
                                            )
                                            if relevance is not None:
                                                st.caption(
                                                    "Combined relevance score: "
                                                    f"{relevance:.3f}"
                                                )
                                            quality = product.get(
                                                "listing_quality"
                                            )
                                            if quality is not None:
                                                if quality >= 0.60:
                                                    quality_label = "Stronger shopping-listing signals"
                                                else:
                                                    quality_label = "Listing type uncertain; verify before buying"
                                                st.caption(
                                                    f"{quality_label} "
                                                    f"(score: {quality:.2f})"
                                                )
                                            price = product.get("price", "")
                                            currency = product.get("currency", "")
                                            if isinstance(price, dict):
                                                currency = (
                                                    price.get("currency")
                                                    or currency
                                                )
                                                price_text = (
                                                    price.get("value")
                                                    or price.get("extracted_value")
                                                    or price.get("raw")
                                                    or ""
                                                )
                                            else:
                                                price_text = str(price or "")
                                            if price_text:
                                                price_display = (
                                                    f"{currency} {price_text}".strip()
                                                )
                                                st.write(f"Price: {price_display}")
                                            else:
                                                st.caption("Price not available")
                                            if link:
                                                link_info = classify_product_link(
                                                    link,
                                                    title=title,
                                                    source=source,
                                                )
                                                if not link_info["valid_url"]:
                                                    st.caption(
                                                        "No valid destination link available."
                                                    )
                                                elif link_info["likely_product_page"]:
                                                    st.link_button(
                                                        "View Product",
                                                        link
                                                    )
                                                    st.caption(
                                                        "Product-like URL; destination "
                                                        "has not been independently verified."
                                                    )
                                                else:
                                                    st.link_button(
                                                        "Open Original Result",
                                                        link
                                                    )
                                                    st.caption(
                                                        "This may be a general page rather "
                                                        "than the exact product."
                                                    )
                                        st.markdown("---")
                else:
                    st.warning(
                        "This does not appear to be "
                        "shopping-relevant."
                    )
            # -----------------------------
            # INITIAL STATE
            # -----------------------------
            else:
                st.info(
                    "Click 'Understand Object' "
                    "to analyze your selection."
                )
        st.markdown("---")
        if st.button(
            "🆕 Select Another Object",
            use_container_width=True
        ):
            reset_selection()
            st.rerun()
else:
    st.info(
        "Upload an image above to start."
    )


