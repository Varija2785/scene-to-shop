# ==================================================
# SIDE NAVIGATION: SHOP / WISHLIST / COMPARISON
# ==================================================
if "comparison_folders" not in st.session_state:
    st.session_state["comparison_folders"] = {}

with st.sidebar:
    st.markdown("## 🛍️ Scene-to-Shop")
    st.caption("Your shopping space")
    nav_choice = st.radio(
        "Navigate",
        ["Shop", "Wishlist", "Comparison"],
        key="active_page",
        label_visibility="collapsed",
    )
    st.divider()
    st.caption(f"♥ Wishlist · {len(st.session_state['wishlist'])}")
    st.caption(f"▣ Comparison folders · {len(st.session_state['comparison_folders'])}")

if nav_choice == "Wishlist":
    st.title(f"♥ Wishlist ({len(st.session_state['wishlist'])})")
    if not st.session_state["wishlist"]:
        st.info("Your Wishlist is empty. Add products using the heart button on a product card.")
    else:
        cols = st.columns(4, gap="medium")
        for index, item in enumerate(st.session_state["wishlist"]):
            with cols[index % 4]:
                with st.container(border=True):
                    if item.get("thumbnail"):
                        st.image(item["thumbnail"], width="stretch")
                    st.markdown(f"**{item.get('title') or 'Untitled product'}**")
                    st.caption(source_app_name(item))
                    st.markdown(f"**{display_price(item)}**")
                    if item.get("link"):
                        st.link_button("Open Product", item["link"], width="stretch")
                    if st.button("✕ Remove from Wishlist", key=f"wishlist_page_remove_{product_id(item)}", width="stretch"):
                        toggle_wishlist(item)
                        st.rerun()
    st.stop()

if nav_choice == "Comparison":
    folders = st.session_state.get("comparison_folders", {})
    st.title(f"▣ Comparison Folders ({len(folders)})")
    if not folders:
        st.info("No comparison folders yet. Click the compare arrows on products to create a folder automatically.")
    for folder_name, items in list(folders.items()):
        with st.expander(f"📁 {folder_name} · {len(items)} products", expanded=True):
            cols = st.columns(max(1, len(items)), gap="medium")
            for index, item in enumerate(items):
                with cols[index]:
                    with st.container(border=True):
                        if item.get("thumbnail"):
                            st.image(item["thumbnail"], width="stretch")
                        st.markdown(f"**{item.get('title') or 'Untitled product'}**")
                        st.caption(source_app_name(item))
                        st.markdown(f"**{display_price(item)}**")
                        similarity = item.get("visual_similarity")
                        if similarity is not None:
                            st.caption(f"Image similarity: {similarity:.3f}")
                        relevance = item.get("relevance_score")
                        if relevance is not None:
                            st.caption(f"Relevance: {relevance:.3f}")
                        if item.get("link"):
                            st.link_button("Open Product", item["link"], width="stretch")
                        if st.button("Remove", key=f"folder_remove_{folder_name}_{product_id(item)}", width="stretch"):
                            remove_from_comparison(folder_name, item)
                            st.rerun()
            folder_token = hashlib.sha256(folder_name.encode("utf-8")).hexdigest()[:12]
            if st.button(
                f"Delete folder: {folder_name}",
                key=f"delete_folder_{folder_token}",
            ):
                st.session_state["confirm_delete_folder"] = folder_name
                st.rerun()

            if st.session_state.get("confirm_delete_folder") == folder_name:
                st.warning(f"Delete '{folder_name}' and all products inside it?")
                confirm_col, cancel_col = st.columns(2)
                with confirm_col:
                    if st.button("Yes, delete folder", key=f"confirm_delete_{folder_token}"):
                        all_folders = dict(st.session_state["comparison_folders"])
                        all_folders.pop(folder_name, None)
                        st.session_state["comparison_folders"] = all_folders
                        st.session_state["compare_products"] = [
                            p for group in all_folders.values() for p in group
                        ]
                        st.session_state.pop("confirm_delete_folder", None)
                        st.rerun()
                with cancel_col:
                    if st.button("Cancel", key=f"cancel_delete_{folder_token}"):
                        st.session_state.pop("confirm_delete_folder", None)
                        st.rerun()
    st.stop()

# ==================================================
# APP HEADER
# ==================================================
st.title("🛍️ Scene-to-Shop")
st.subheader("Select anything you want to shop for")
st.write(
    "Upload a scene, select an object, and let AI "
    "find visually similar products. Use the left menu to open Wishlist or Comparison."
)
# ==================================================
# IMAGE UPLOAD AND OBJECT SELECTION
# ==================================================
uploaded_file = st.file_uploader(
    "Upload an image",
    type=["jpg", "jpeg", "png"],
    key="scene_upload",
)
if uploaded_file:
    image = Image.open(uploaded_file).convert("RGB")
    st.markdown("### 1. Select the object")
    st.info("Draw a rectangle around the object you want to shop for.")
    canvas_width = min(1000, image.width)
    scale = canvas_width / image.width
    canvas_height = int(image.height * scale)
    display_image = image.resize((canvas_width, canvas_height))
    canvas_result = st_canvas(
        fill_color="rgba(0, 200, 255, 0.20)",
        stroke_width=4,
        stroke_color="#00AEEF",
        background_image=display_image,
        update_streamlit=True,
        height=canvas_height,
        width=canvas_width,
        drawing_mode="rect",
        key=f"object_selector_{st.session_state['canvas_reset_counter']}",
    )
    button_col1, button_col2 = st.columns(2, gap="medium")
    with button_col1:
        understand_clicked = st.button(
            "🔍 Understand Object",
            type="primary",
            width="stretch",
        )
    with button_col2:
        retry_selection_clicked = st.button(
            "↩ Retry Selection",
            width="stretch",
        )
    if retry_selection_clicked:
        reset_selection()
        st.rerun()
    if understand_clicked:
        objects = (
            canvas_result.json_data.get("objects", [])
            if canvas_result.json_data
            else []
        )
        if not objects:
            st.warning("Please draw a rectangle around an object first.")
        else:
            rect = objects[-1]
            left = rect.get("left", 0)
            top = rect.get("top", 0)
            rect_width = rect.get("width", 0)
            rect_height = rect.get("height", 0)
            if rect_width < 15 or rect_height < 15:
                st.warning("The selected area is too small.")
            else:
                scale_x = image.width / canvas_width
                scale_y = image.height / canvas_height
                x1 = max(0, int(left * scale_x))
                y1 = max(0, int(top * scale_y))
                x2 = min(
                    image.width,
                    int((left + rect_width) * scale_x),
                )
                y2 = min(
                    image.height,
                    int((top + rect_height) * scale_y),
                )
                padding_x = int((x2 - x1) * 0.15)
                padding_y = int((y2 - y1) * 0.15)
                crop_x1 = max(0, x1 - padding_x)
                crop_y1 = max(0, y1 - padding_y)
                crop_x2 = min(image.width, x2 + padding_x)
                crop_y2 = min(image.height, y2 + padding_y)
                selected = image.crop(
                    (crop_x1, crop_y1, crop_x2, crop_y2)
                )
                output_path = OUTPUT_DIR / "selected_object.jpg"
                selected.save(output_path, quality=95)
                st.session_state["selected_object"] = selected
                clear_analysis()
                # Clear old results when a new object is selected.
                st.session_state["scene_search_results"] = None
                st.session_state["scene_search_error"] = None
                with st.spinner("AI is understanding the selected object..."):
                    result = analyze_object(selected)
                if "error" in result:
                    st.session_state["analysis_error"] = result["error"]
                else:
                    save_analysis(result)
# ==================================================
# AI UNDERSTANDING
# Product results are NOT rendered inside these columns.
# ==================================================
if "selected_object" in st.session_state:
    st.markdown("---")
    st.markdown("### 2. AI Understanding")
    selected_object = st.session_state["selected_object"]
    image_col, details_col = st.columns([1, 1], gap="large")
    with image_col:
        st.image(
            selected_object,
            caption="Selected object",
            width="stretch",
        )
    with details_col:
        if "analysis_error" in st.session_state:
            st.warning("AI understanding is temporarily unavailable.")
            st.write(st.session_state["analysis_error"])
            if st.button(
                "🔄 Retry AI Analysis",
                type="primary",
                width="stretch",
            ):
                clear_analysis()
                with st.spinner("Trying AI analysis again..."):
                    result = analyze_object(selected_object)
                if "error" in result:
                    st.session_state["analysis_error"] = result["error"]
                else:
                    save_analysis(result)
                st.rerun()
        elif "object_name" in st.session_state:
            object_name = st.session_state["object_name"]
            description = st.session_state.get("description", "")
            confidence = st.session_state.get("confidence", 0.0)
            shopping_relevant = st.session_state.get(
                "shopping_relevant", False
            )
            st.success(f"**{object_name}**")
            if description:
                st.write(description)
            st.write(f"AI confidence: **{confidence * 100:.1f}%**")
            if shopping_relevant:
                st.success("Suitable for visual shopping")
                if st.button(
                    "🛍️ Find Similar Products",
                    type="primary",
                    width="stretch",
                ):
                    if not SERPAPI_API_KEY:
                        st.session_state["scene_search_error"] = (
                            "SERPAPI_API_KEY is not configured in .env"
                        )
                        st.session_state["scene_search_results"] = None
                    else:
                        with st.spinner(
                            "Searching for visually similar products..."
                        ):
                            search_result = search_google_lens(
                                OUTPUT_DIR / "selected_object.jpg",
                                SERPAPI_API_KEY,
                                max_results=12,
                            )
                            if not search_result.get("error"):
                                products = search_result.get("results", [])
                                if products:
                                    products = rank_products(
                                        selected_object,
                                        products,
                                        max_products=12,
                                    )
                                    search_result["results"] = products
                        if search_result.get("error"):
                            st.session_state["scene_search_error"] = (
                                search_result["error"]
                            )
                            st.session_state["scene_search_results"] = None
                        else:
                            st.session_state["scene_search_results"] = (
                                search_result.get("results", [])
                            )
                            st.session_state["scene_search_error"] = None
                    st.rerun()
            else:
                st.warning("This does not appear to be shopping-relevant.")
        else:
            st.info("Click 'Understand Object' to analyze your selection.")
# ==================================================
# FULL-WIDTH SHOPPING RESULTS
# This section is outside the image/details columns.
# ==================================================
if "selected_object" in st.session_state:
    search_error = st.session_state.get("scene_search_error")
    if search_error:
        st.error(search_error)
    products = st.session_state.get("scene_search_results")
    if products:
        st.markdown("---")
        st.markdown("### 3. Similar Products")
        st.caption(
            f"Showing {len(products)} visually ranked results"
        )
        # Four cards per row. Each row spans the full page width.
        for row_start in range(0, len(products), 4):
            row_products = products[row_start:row_start + 4]
            product_columns = st.columns(4, gap="medium")
            for offset, product in enumerate(row_products):
                with product_columns[offset]:
                    title = product.get("title") or "Untitled product"
                    source = source_app_name(product)
                    thumbnail = product.get("thumbnail") or ""
                    link = product.get("link") or ""
                    pid = product_id(product)
                    price_display = display_price(product)
                    with st.container(border=True):
                        wishlist_ids = [product_id(item) for item in st.session_state["wishlist"]]
                        is_wishlisted = pid in wishlist_ids
                        current_folder_items = st.session_state.get("comparison_folders", {}).get(comparison_folder_name(), [])
                        is_compared = pid in [product_id(item) for item in current_folder_items]
                        action_col1, action_col2 = st.columns(2, gap="small")
                        with action_col1:
                            if st.button("♥" if is_wishlisted else "♡", key=f"wishlist_icon_{pid}", help="Remove from Wishlist" if is_wishlisted else "Add to Wishlist", width="stretch"):
                                toggle_wishlist(product)
                                st.rerun()
                        with action_col2:
                            if st.button("⇄ ✓" if is_compared else "⇄", key=f"compare_icon_{pid}", help=f"Remove from {comparison_folder_name()}" if is_compared else f"Add to {comparison_folder_name()}", width="stretch"):
                                toggle_compare(product)
                                st.rerun()
                        if thumbnail:
                            try:
                                st.image(thumbnail, width="stretch")
                            except Exception:
                                st.caption("Product image unavailable")
                        else:
                            st.caption("No product image available")
                        st.markdown(f"**{title}**")
                        if source:
                            st.caption(source)
                        st.markdown(f"**{price_display}**")
                        visual_similarity = product.get("visual_similarity")
                        if visual_similarity is not None:
                            st.caption(
                                f"Image similarity: {visual_similarity:.3f}"
                            )
                        title_similarity = product.get("title_similarity")
                        if title_similarity is not None:
                            st.caption(
                                f"Title relevance: {title_similarity:.3f}"
                            )
                        relevance = product.get("relevance_score")
                        if relevance is not None:
                            st.caption(
                                f"Combined relevance: {relevance:.3f}"
                            )
                        quality = product.get("listing_quality")
                        if quality is not None:
                            quality_label = (
                                "Stronger shopping-listing signals"
                                if quality >= 0.60
                                else "Listing type uncertain; verify before buying"
                            )
                            st.caption(
                                f"{quality_label} ({quality:.2f})"
                            )
                        if link:
                            link_info = classify_product_link(
                                link,
                                title=title,
                                source=source,
                            )
                            if not link_info.get("valid_url"):
                                st.caption(
                                    "No valid destination link available."
                                )
                            elif link_info.get("likely_product_page"):
                                st.link_button(
                                    f"Open Product on {source}",
                                    link,
                                    width="stretch",
                                )
                                st.caption(
                                    "Product-like URL; destination has "
                                    "not been independently verified."
                                )
                            else:
                                st.link_button(
                                    f"Open Original Result ({source})",
                                    link,
                                    width="stretch",
                                )
                                st.caption(
                                    "This may be a general page rather "
                                    "than the exact product."
                                )
    elif products == []:
        st.info("No visual product matches were found.")
    # --------------------------------------------------
    # SELECT ANOTHER OBJECT
    # --------------------------------------------------
    st.markdown("---")
    if st.button("🆕 Select Another Object", width="stretch"):
        reset_selection()
        st.rerun()
else:
    st.info("Upload an image above to start.")
