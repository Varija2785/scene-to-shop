import streamlit as st
from streamlit_drawable_canvas import st_canvas
from PIL import Image
from pathlib import Path
from dotenv import load_dotenv
from google import genai
import os
import json
import time
st.set_page_config(
    page_title="Scene-to-Shop",
    page_icon="🛍️",
    layout="wide"
)

BASE_DIR = Path(__file__).resolve().parents[3]
OUTPUT_DIR = BASE_DIR / "vision" / "selection" / "ui_outputs"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
load_dotenv(BASE_DIR / ".env")
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
SERPAPI_API_KEY = os.getenv("SERPAPI_API_KEY")
RETRIEVAL_DIR = BASE_DIR / "vision" / "retrieval" / "search"
import sys
if str(RETRIEVAL_DIR) not in sys.path:
    sys.path.insert(0, str(RETRIEVAL_DIR))
from lens_search import search_google_lens
from lens_search import classify_product_link
from visual_ranker import rank_products
MODEL = "gemini-3.6-flash"
def clear_analysis():
    for key in [
        "object_name",
        "description",
        "confidence",
        "shopping_relevant",
        "analysis_error"
    ]:
        st.session_state.pop(key, None)
def reset_selection():
    for key in [
        "selected_object",
        "object_name",
        "description",
        "confidence",
        "shopping_relevant",
        "analysis_error"
    ]:
        st.session_state.pop(key, None)
def analyze_object(image):
    if not GEMINI_API_KEY:
        return {
            "error": "GEMINI_API_KEY is not configured."
        }
    try:
        client = genai.Client(
            api_key=GEMINI_API_KEY
        )
        prompt = """
Look carefully at the selected image.
Identify what is actually visible.
Do NOT use a predefined object/category list.
Do NOT assume the object from the filename.
Do NOT invent details that cannot be seen.
Return ONLY valid JSON:
{
  "object_name": "specific natural name",
  "description": "short visible description",
  "shopping_relevant": true,
  "confidence": 0.0
}
Rules:
- Describe only what can actually be seen.
- Use a specific natural name when supported.
- If unclear, use "Unclear object".
- confidence must be between 0 and 1.
- shopping_relevant should be true if the object
  can reasonably be searched for or purchased.
"""
        response = None
        # Gemini can occasionally return a temporary 503
        # even when the API key and model are working.
        # Retry a few times before showing an error.
        for attempt in range(3):
            try:
                response = client.models.generate_content(
                    model=MODEL,
                    contents=[prompt, image],
                )
                break
            except Exception as retry_error:
                retry_text = str(retry_error)
                if (
                    "503" in retry_text
                    or "UNAVAILABLE" in retry_text
                ):
                    if attempt < 2:
                        time.sleep(2 ** (attempt + 1))
                        continue
                raise
        if response is None:
            raise RuntimeError(
                "Gemini did not return a response."
            )
        text = response.text.strip()
        if text.startswith("```"):
            text = text.replace("```json", "")
            text = text.replace("```", "")
            text = text.strip()
        return json.loads(text)
    except Exception as e:
        error_text = str(e)
        if "503" in error_text or "UNAVAILABLE" in error_text:
            return {
                "error": (
                    "Gemini is temporarily busy. "
                    "Please try again in a moment."
                )
            }
        if "429" in error_text or "RESOURCE_EXHAUSTED" in error_text:
            return {
                "error": (
                    "Gemini API quota is currently exhausted. "
                    "Please try again after the quota resets."
                )
            }
        return {
            "error": error_text
        }
def save_analysis(result):
    st.session_state["object_name"] = result.get(
        "object_name",
        "Unclear object"
    )
    st.session_state["description"] = result.get(
        "description",
        ""
    )
    st.session_state["confidence"] = float(
        result.get(
            "confidence",
            0
        )
    )
    st.session_state["shopping_relevant"] = result.get(
        "shopping_relevant",
        False
    )
    st.session_state.pop(
        "analysis_error",
        None
    )


# SCENE_TO_SHOP_ANIMATED_THEME_V2
st.markdown("""
<style>
:root {
  color-scheme: dark;
  --bg: #080d19;
  --panel: #111a2c;
  --line: rgba(148,163,184,.22);
  --blue: #3b82f6;
  --cyan: #22d3ee;
}
.stApp {
  background:
    radial-gradient(ellipse at 10% 0%, rgba(37,99,235,.20), transparent 35%),
    radial-gradient(ellipse at 90% 12%, rgba(6,182,212,.10), transparent 30%),
    var(--bg);
  color: #e5edf8;
}
[data-testid="stHeader"] { background: rgba(8,13,25,.86); }
[data-testid="stAppViewContainer"] .main .block-container {
  max-width: 1500px;
  padding-top: 1.6rem;
  padding-bottom: 3rem;
}
