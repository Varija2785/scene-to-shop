</style>
""", unsafe_allow_html=True)


st.title("🛍️ Scene-to-Shop")
st.subheader(
    "Select anything you want to shop for"
)
st.write(
    "Upload a scene, select an object, "
    "and let AI understand it."
)
uploaded_file = st.file_uploader(
    "Upload an image",
    type=["jpg", "jpeg", "png"],
    key="scene_upload"
)
if uploaded_file:
    image = Image.open(
        uploaded_file
    ).convert("RGB")
    st.markdown(
        "### 1. Select the object"
    )
    st.info(
        "Draw a rectangle around the object. "
        "It does not need to be perfect."
    )
    canvas_width = min(
        1000,
        image.width
    )
    scale = canvas_width / image.width
    canvas_height = int(
        image.height * scale
    )
    display_image = image.resize(
        (
            canvas_width,
            canvas_height
        )
    )
    canvas_result = st_canvas(
        fill_color="rgba(0, 200, 255, 0.20)",
        stroke_width=4,
        stroke_color="#00AEEF",
        background_image=display_image,
        update_streamlit=True,
        height=canvas_height,
        width=canvas_width,
        drawing_mode="rect",
        key="object_selector"
    )
    col1, col2 = st.columns(2)
    with col1:
        understand_clicked = st.button(
            "🔍 Understand Object",
            type="primary",
            use_container_width=True
        )
    with col2:
        retry_selection_clicked = st.button(
            "↩ Retry Selection",
            use_container_width=True
        )
    if retry_selection_clicked:
        reset_selection()
        st.rerun()
    if understand_clicked:
        if canvas_result.json_data is None:
            st.warning(
                "Please draw a rectangle around an object first."
            )
        else:
            objects = canvas_result.json_data.get(
                "objects",
                []
            )
            if not objects:
                st.warning(
                    "Please draw a rectangle around an object first."
                )
            else:
                rect = objects[-1]
                left = rect.get(
                    "left",
                    0
                )
                top = rect.get(
                    "top",
                    0
                )
                width = rect.get(
                    "width",
                    0
                )
                height = rect.get(
                    "height",
                    0
                )
                if width < 15 or height < 15:
                    st.warning(
                        "The selected area is too small."
                    )
                else:
                    scale_x = (
                        image.width /
                        canvas_width
                    )
                    scale_y = (
                        image.height /
                        canvas_height
                    )
                    x1 = max(
                        0,
                        int(left * scale_x)
                    )
                    y1 = max(
                        0,
                        int(top * scale_y)
                    )
                    x2 = min(
                        image.width,
                        int(
                            (left + width)
                            * scale_x
                        )
                    )
                    y2 = min(
                        image.height,
                        int(
                            (top + height)
                            * scale_y
                        )
                    )
                    # Add padding around the selected object.
                    # This prevents tiny selections from producing
                    # extremely small crops such as 69x80 pixels.
                    box_width = x2 - x1
                    box_height = y2 - y1
                    padding_x = int(box_width * 0.15)
                    padding_y = int(box_height * 0.15)
                    crop_x1 = max(0, x1 - padding_x)
                    crop_y1 = max(0, y1 - padding_y)
                    crop_x2 = min(image.width, x2 + padding_x)
                    crop_y2 = min(image.height, y2 + padding_y)
                    selected = image.crop(
                        (
                            crop_x1,
                            crop_y1,
                            crop_x2,
                            crop_y2
                        )
                    )
                    output_path = (
                        OUTPUT_DIR /
                        "selected_object.jpg"
                    )
                    selected.save(
                        output_path,
                        quality=95
                    )
                    st.session_state[
                        "selected_object"
                    ] = selected
                    clear_analysis()
                    with st.spinner(
                        "AI is understanding the selected object..."
                    ):
                        result = analyze_object(
                            selected
                        )
                    if "error" in result:
                        st.session_state[
                            "analysis_error"
                        ] = result["error"]
                    else:
                        save_analysis(
                            result
                        )
    # --------------------------------------------------
    # SELECTED OBJECT RESULT
    # --------------------------------------------------
    if "selected_object" in st.session_state:
        st.markdown("---")
        st.markdown(
            "### 2. AI Understanding"
        )
        selected_object = (
            st.session_state[
                "selected_object"
            ]
        )
        col1, col2 = st.columns(
            [1, 1]
        )
        with col1:
            st.image(
                selected_object,
                caption="Selected object",
                use_container_width=True
            )
        with col2:
            # -----------------------------
            # ERROR STATE
            # -----------------------------
            if "analysis_error" in st.session_state:
                st.warning(
                    "⚠️ AI understanding is temporarily unavailable."
                )
                st.write(
                    st.session_state[
                        "analysis_error"
                    ]
                )
                retry_ai_clicked = st.button(
                    "🔄 Retry AI Analysis",
                    type="primary",
                    use_container_width=True
                )
                if retry_ai_clicked:
                    clear_analysis()
                    with st.spinner(
                        "Trying AI analysis again..."
                    ):
                        result = analyze_object(
                            selected_object
                        )
                    if "error" in result:
                        st.session_state[
                            "analysis_error"
                        ] = result["error"]
                    else:
                        save_analysis(
                            result
                        )
                    st.rerun()
            # -----------------------------
            # SUCCESS STATE
            # -----------------------------
            elif "object_name" in st.session_state:
                object_name = (
                    st.session_state[
                        "object_name"
                    ]
                )
                description = (
                    st.session_state[
                        "description"
                    ]
                )
                confidence = (
                    st.session_state[
                        "confidence"
                    ]
                )
                shopping_relevant = (
                    st.session_state[
                        "shopping_relevant"
                    ]
                )
                st.success(
                    f"**{object_name}**"
                )
                st.write(
                    description
                )
                st.write(
                    f"AI confidence: "
                    f"**{confidence * 100:.1f}%**"
                )
                if shopping_relevant:
                    st.success(
                        "? Suitable for visual shopping"
                    )
                    find_products_clicked = st.button(
                        "Find Similar Products",
                        type="primary",
                        use_container_width=True
                    )
                    if find_products_clicked:
                        if not SERPAPI_API_KEY:
                            st.error(
                                "SERPAPI_API_KEY is not configured in .env"
                            )
                        else:
                            with st.spinner(
                                "?? Searching for visually similar products..."
                            ):
                                search_result = search_google_lens(
                                    OUTPUT_DIR / "selected_object.jpg",
                                    SERPAPI_API_KEY,
                                    max_results=12
                                )
                                if not search_result.get("error"):
                                    products = search_result.get(
                                        "results",
                                        []
                                    )
                                    if products:
                                        products = rank_products(
                                            selected_object,
                                            products,
                                            max_products=12
                                        )
                                        search_result["results"] = products
                            if search_result.get("error"):
                                st.error(
                                    search_result["error"]
                                )
                            else:
                                products = search_result.get(
                                    "results",
                                    []
                                )
                                if not products:
                                    st.warning(
                                        "No visual product matches were found."
                                    )
                                else:
                                    st.markdown("### ? Shopping results")
                                    st.caption(
                                        f"{len(products)} visual matches ? "
                                        "Ranked using image and listing signals"
                                    )
                                    # Interactive shopping controls
                                    if "scene_wishlist" not in st.session_state:
                                        st.session_state["scene_wishlist"] = []
                                    if "scene_compare" not in st.session_state:
                                        st.session_state["scene_compare"] = []
                                    sort_mode = st.selectbox(
                                        "Sort products",
                                        [
                                            "Best visual match",
                                            "Highest listing quality",
                                            "Lowest price",
                                        ],
                                        key="scene_product_sort",
                                    )
                                    display_products = list(products)
                                    def _scene_price_value(item):
                                        value = item.get("price", "")
                                        if isinstance(value, dict):
                                            value = (
                                                value.get("value")
                                                or value.get("extracted_value")
                                                or value.get("raw")
                                                or ""
                                            )
                                        import re
                                        match = re.search(
                                            r"\d[\d,]*(?:\.\d+)?",
                                            str(value or ""),
                                        )
                                        if not match:
                                            return None
                                        try:
                                            return float(
                                                match.group(0).replace(",", "")
                                            )
                                        except ValueError:
                                            return None
                                    if sort_mode == "Best visual match":
                                        display_products.sort(
                                            key=lambda p: float(
                                                p.get("relevance_score")
                                                if p.get("relevance_score") is not None
                                                else -1
                                            ),
                                            reverse=True,
                                        )
                                    elif sort_mode == "Highest listing quality":
                                        display_products.sort(
                                            key=lambda p: float(
                                                p.get("listing_quality")
                                                if p.get("listing_quality") is not None
                                                else -1
                                            ),
                                            reverse=True,
                                        )
                                    else:
                                        display_products.sort(
                                            key=lambda p: (
                                                _scene_price_value(p) is None,
                                                _scene_price_value(p)
                                                if _scene_price_value(p) is not None
                                                else float("inf"),
                                            )
                                        )
                                    grid_columns = st.columns(4, gap="medium")
                                    for index, product in enumerate(display_products):
                                        with grid_columns[index % 4]:
                                            title = str(
                                                product.get("title")
                                                or "Untitled product"
                                            )
                                            source_name = str(
                                                product.get("source") or ""
                                            )
                                            thumbnail = product.get("thumbnail") or ""
                                            link = product.get("link") or ""
                                            price = product.get("price", "")
                                            currency = product.get("currency") or ""
                                            if isinstance(price, dict):
                                                currency = (
                                                    price.get("currency")
                                                    or currency
                                                )
                                                price_text = (
                                                    price.get("value")
                                                    or price.get("extracted_value")
                                                    or price.get("raw")
                                                    or ""
                                                )
                                            else:
                                                price_text = str(price or "")
                                            product_key = (
                                                str(product.get("product_id") or "")
                                                or link
                                                or f"{title}_{index}"
                                            )
                                            product_key = product_key[:180]
                                            with st.container(border=True):
                                                if thumbnail:
                                                    st.image(
                                                        thumbnail,
                                                        width="stretch",
                                                    )
                                                else:
                                                    st.markdown(
                                                        '<div class="scene-no-image">'
                                                        'Image unavailable</div>',
                                                        unsafe_allow_html=True,
                                                    )
                                                st.markdown(
                                                    f"**{title[:115]}**"
                                                    + ("?" if len(title) > 115 else "")
                                                )
                                                if source_name:
                                                    st.caption(source_name)
                                                if price_text:
                                                    st.markdown(
                                                        f"### {currency} {price_text}".strip()
                                                    )
                                                else:
                                                    st.caption("Price unavailable")
                                                relevance = product.get("relevance_score")
                                                if relevance is not None:
                                                    st.caption(
                                                        f"Match score: {relevance:.3f}"
                                                    )
                                                quality = product.get("listing_quality")
                                                if quality is not None:
                                                    quality_label = (
                                                        "Stronger listing signals"
                                                        if quality >= 0.60
                                                        else "Verify listing before buying"
                                                    )
                                                    st.caption(quality_label)
                                                valid_link = False
                                                link_info = None
                                                if link:
                                                    link_info = classify_product_link(
                                                        link,
                                                        title=title,
                                                        source=source_name,
                                                    )
                                                    valid_link = bool(
                                                        link_info.get("valid_url")
                                                    )
                                                if valid_link:
                                                    button_label = (
                                                        "View Product"
                                                        if link_info.get(
                                                            "likely_product_page"
                                                        )
                                                        else "Open Result"
                                                    )
                                                    st.link_button(
                                                        button_label,
                                                        link,
                                                        width="stretch",
                                                    )
                                                else:
                                                    st.button(
                                                        "Link unavailable",
                                                        key=f"scene_no_link_{index}",
                                                        disabled=True,
                                                        width="stretch",
                                                    )
                                                wishlisted = product_key in (
                                                    st.session_state["scene_wishlist"]
                                                )
                                                if st.button(
                                                    "? Saved" if wishlisted else "? Wishlist",
                                                    key=f"scene_wish_{index}",
                                                    width="stretch",
                                                ):
                                                    items = st.session_state[
                                                        "scene_wishlist"
                                                    ]
                                                    if product_key in items:
                                                        items.remove(product_key)
                                                    else:
                                                        items.append(product_key)
                                                    st.rerun()
                                                compared = product_key in (
                                                    st.session_state["scene_compare"]
                                                )
                                                if st.button(
                                                    "? Compare selected"
                                                    if compared
                                                    else "? Compare",
                                                    key=f"scene_compare_{index}",
                                                    width="stretch",
                                                ):
                                                    items = st.session_state[
                                                        "scene_compare"
                                                    ]
                                                    if product_key in items:
                                                        items.remove(product_key)
                                                    elif len(items) < 4:
                                                        items.append(product_key)
                                                    else:
                                                        st.warning(
                                                            "Compare up to four products."
                                                        )
                                                    st.rerun()
                                    selected_compare = st.session_state["scene_compare"]
                                    if selected_compare:
                                        st.markdown("### ?? Compare selection")
                                        st.caption(
                                            f"{len(selected_compare)} product(s) selected. "
                                            "Choose products above to add or remove them."
                                        )
                                        compare_lookup = {}
                                        for idx, item in enumerate(display_products):
                                            item_link = str(item.get("link") or "")
                                            item_title = str(
                                                item.get("title") or "Untitled product"
                                            )
                                            item_key = (
                                                str(item.get("product_id") or "")
                                                or item_link
                                                or f"{item_title}_{idx}"
                                            )[:180]
                                            compare_lookup[item_key] = item
                                        compare_items = [
                                            compare_lookup[key]
                                            for key in selected_compare
                                            if key in compare_lookup
                                        ]
                                        if compare_items:
                                            compare_cols = st.columns(
                                                len(compare_items)
                                            )
                                            for compare_col, item in zip(
                                                compare_cols, compare_items
                                            ):
                                                with compare_col:
                                                    st.markdown(
                                                        f"**{str(item.get('title') or 'Untitled')[:100]}**"
                                                    )
                                                    item_price = item.get("price", "")
                                                    if isinstance(item_price, dict):
                                                        item_price = (
                                                            item_price.get("value")
                                                            or item_price.get("extracted_value")
                                                            or item_price.get("raw")
                                                            or ""
                                                        )
                                                    st.write(
                                                        f"Price: {item_price or 'Unavailable'}"
                                                    )
                                                    st.write(
                                                        "Match score: "
                                                        + str(
                                                            item.get(
                                                                "relevance_score",
                                                                "Unavailable",
                                                            )
                                                        )
                                                    )
                                    if st.session_state["scene_wishlist"]:
                                        st.markdown("### ? Wishlist")
                                        st.caption(
                                            f"{len(st.session_state['scene_wishlist'])} "
                                            "product(s) saved for this session."
                                        )

                else:
                    st.warning(
                        "This does not appear to be "
                        "shopping-relevant."
                    )
            # -----------------------------
            # INITIAL STATE
            # -----------------------------
            else:
                st.info(
                    "Click 'Understand Object' "
                    "to analyze your selection."
                )
        st.markdown("---")
        if st.button(
            "🆕 Select Another Object",
            use_container_width=True
        ):
            reset_selection()
            st.rerun()
else:
    st.info(
        "Upload an image above to start."
    )


