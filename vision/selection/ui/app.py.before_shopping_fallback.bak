import streamlit as st
from streamlit_drawable_canvas import st_canvas
from PIL import Image
from pathlib import Path
from dotenv import load_dotenv
from google import genai
import os
import json
import time
st.set_page_config(
    page_title="Scene-to-Shop",
    page_icon="🛍️",
    layout="wide"
)
BASE_DIR = Path(__file__).resolve().parents[3]
OUTPUT_DIR = BASE_DIR / "vision" / "selection" / "ui_outputs"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
load_dotenv(BASE_DIR / ".env")
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
SERPAPI_API_KEY = os.getenv("SERPAPI_API_KEY")
RETRIEVAL_DIR = BASE_DIR / "vision" / "retrieval" / "search"
import sys
if str(RETRIEVAL_DIR) not in sys.path:
    sys.path.insert(0, str(RETRIEVAL_DIR))
from lens_search import search_google_lens
from visual_ranker import rank_products
MODEL = "gemini-3.6-flash"
def clear_analysis():
    for key in [
        "object_name",
        "description",
        "confidence",
        "shopping_relevant",
        "analysis_error"
    ]:
        st.session_state.pop(key, None)
def reset_selection():
    for key in [
        "selected_object",
        "object_name",
        "description",
        "confidence",
        "shopping_relevant",
        "analysis_error"
    ]:
        st.session_state.pop(key, None)
def analyze_object(image):
    if not GEMINI_API_KEY:
        return {
            "error": "GEMINI_API_KEY is not configured."
        }
    try:
        client = genai.Client(
            api_key=GEMINI_API_KEY
        )
        prompt = """
Look carefully at the selected image.
Identify what is actually visible.
Do NOT use a predefined object/category list.
Do NOT assume the object from the filename.
Do NOT invent details that cannot be seen.
Return ONLY valid JSON:
{
  "object_name": "specific natural name",
  "description": "short visible description",
  "shopping_relevant": true,
  "confidence": 0.0
}
Rules:
- Describe only what can actually be seen.
- Use a specific natural name when supported.
- If unclear, use "Unclear object".
- confidence must be between 0 and 1.
- shopping_relevant should be true if the object
  can reasonably be searched for or purchased.
"""
        response = None
        # Gemini can occasionally return a temporary 503
        # even when the API key and model are working.
        # Retry a few times before showing an error.
        for attempt in range(3):
            try:
                response = client.models.generate_content(
                    model=MODEL,
                    contents=[prompt, image],
                )
                break
            except Exception as retry_error:
                retry_text = str(retry_error)
                if (
                    "503" in retry_text
                    or "UNAVAILABLE" in retry_text
                ):
                    if attempt < 2:
                        time.sleep(2 ** (attempt + 1))
                        continue
                raise
        if response is None:
            raise RuntimeError(
                "Gemini did not return a response."
            )
        text = response.text.strip()
        if text.startswith("```"):
            text = text.replace("```json", "")
            text = text.replace("```", "")
            text = text.strip()
        return json.loads(text)
    except Exception as e:
        error_text = str(e)
        if "503" in error_text or "UNAVAILABLE" in error_text:
            return {
                "error": (
                    "Gemini is temporarily busy. "
                    "Please try again in a moment."
                )
            }
        if "429" in error_text or "RESOURCE_EXHAUSTED" in error_text:
            return {
                "error": (
                    "Gemini API quota is currently exhausted. "
                    "Please try again after the quota resets."
                )
            }
        return {
            "error": error_text
        }
def save_analysis(result):
    st.session_state["object_name"] = result.get(
        "object_name",
        "Unclear object"
    )
    st.session_state["description"] = result.get(
        "description",
        ""
    )
    st.session_state["confidence"] = float(
        result.get(
            "confidence",
            0
        )
    )
    st.session_state["shopping_relevant"] = result.get(
        "shopping_relevant",
        False
    )
    st.session_state.pop(
        "analysis_error",
        None
    )
st.title("🛍️ Scene-to-Shop")
st.subheader(
    "Select anything you want to shop for"
)
st.write(
    "Upload a scene, select an object, "
    "and let AI understand it."
)
uploaded_file = st.file_uploader(
    "Upload an image",
    type=["jpg", "jpeg", "png"],
    key="scene_upload"
)
if uploaded_file:
    image = Image.open(
        uploaded_file
    ).convert("RGB")
    st.markdown(
        "### 1. Select the object"
    )
    st.info(
        "Draw a rectangle around the object. "
        "It does not need to be perfect."
    )
    canvas_width = min(
        1000,
        image.width
    )
    scale = canvas_width / image.width
    canvas_height = int(
        image.height * scale
    )
    display_image = image.resize(
        (
            canvas_width,
            canvas_height
        )
    )
    canvas_result = st_canvas(
        fill_color="rgba(0, 200, 255, 0.20)",
        stroke_width=4,
        stroke_color="#00AEEF",
        background_image=display_image,
        update_streamlit=True,
        height=canvas_height,
        width=canvas_width,
        drawing_mode="rect",
        key="object_selector"
    )
    col1, col2 = st.columns(2)
    with col1:
        understand_clicked = st.button(
            "🔍 Understand Object",
            type="primary",
            use_container_width=True
        )
    with col2:
        retry_selection_clicked = st.button(
            "↩ Retry Selection",
            use_container_width=True
        )
    if retry_selection_clicked:
        reset_selection()
        st.rerun()
    if understand_clicked:
        if canvas_result.json_data is None:
            st.warning(
                "Please draw a rectangle around an object first."
            )
        else:
            objects = canvas_result.json_data.get(
                "objects",
                []
            )
            if not objects:
                st.warning(
                    "Please draw a rectangle around an object first."
                )
            else:
                rect = objects[-1]
                left = rect.get(
                    "left",
                    0
                )
                top = rect.get(
                    "top",
                    0
                )
                width = rect.get(
                    "width",
                    0
                )
                height = rect.get(
                    "height",
                    0
                )
                if width < 15 or height < 15:
                    st.warning(
                        "The selected area is too small."
                    )
                else:
                    scale_x = (
                        image.width /
                        canvas_width
                    )
                    scale_y = (
                        image.height /
                        canvas_height
                    )
                    x1 = max(
                        0,
                        int(left * scale_x)
                    )
                    y1 = max(
                        0,
                        int(top * scale_y)
                    )
                    x2 = min(
                        image.width,
                        int(
                            (left + width)
                            * scale_x
                        )
                    )
                    y2 = min(
                        image.height,
                        int(
                            (top + height)
                            * scale_y
                        )
                    )
                    # Add padding around the selected object.
                    # This prevents tiny selections from producing
                    # extremely small crops such as 69x80 pixels.
                    box_width = x2 - x1
                    box_height = y2 - y1
                    padding_x = int(box_width * 0.15)
                    padding_y = int(box_height * 0.15)
                    crop_x1 = max(0, x1 - padding_x)
                    crop_y1 = max(0, y1 - padding_y)
                    crop_x2 = min(image.width, x2 + padding_x)
                    crop_y2 = min(image.height, y2 + padding_y)
                    selected = image.crop(
                        (
                            crop_x1,
                            crop_y1,
                            crop_x2,
                            crop_y2
                        )
                    )
                    output_path = (
                        OUTPUT_DIR /
                        "selected_object.jpg"
                    )
                    selected.save(
                        output_path,
                        quality=95
                    )
                    st.session_state[
                        "selected_object"
                    ] = selected
                    clear_analysis()
                    with st.spinner(
                        "AI is understanding the selected object..."
                    ):
                        result = analyze_object(
                            selected
                        )
                    if "error" in result:
                        st.session_state[
                            "analysis_error"
                        ] = result["error"]
                    else:
                        save_analysis(
                            result
                        )
    # --------------------------------------------------
    # SELECTED OBJECT RESULT
    # --------------------------------------------------
    if "selected_object" in st.session_state:
        st.markdown("---")
        st.markdown(
            "### 2. AI Understanding"
        )
        selected_object = (
            st.session_state[
                "selected_object"
            ]
        )
        col1, col2 = st.columns(
            [1, 1]
        )
        with col1:
            st.image(
                selected_object,
                caption="Selected object",
                use_container_width=True
            )
        with col2:
            # -----------------------------
            # ERROR STATE
            # -----------------------------
            if "analysis_error" in st.session_state:
                st.warning(
                    "⚠️ AI understanding is temporarily unavailable."
                )
                st.write(
                    st.session_state[
                        "analysis_error"
                    ]
                )
                retry_ai_clicked = st.button(
                    "🔄 Retry AI Analysis",
                    type="primary",
                    use_container_width=True
                )
                if retry_ai_clicked:
                    clear_analysis()
                    with st.spinner(
                        "Trying AI analysis again..."
                    ):
                        result = analyze_object(
                            selected_object
                        )
                    if "error" in result:
                        st.session_state[
                            "analysis_error"
                        ] = result["error"]
                    else:
                        save_analysis(
                            result
                        )
                    st.rerun()
            # -----------------------------
            # SUCCESS STATE
            # -----------------------------
            elif "object_name" in st.session_state:
                object_name = (
                    st.session_state[
                        "object_name"
                    ]
                )
                description = (
                    st.session_state[
                        "description"
                    ]
                )
                confidence = (
                    st.session_state[
                        "confidence"
                    ]
                )
                shopping_relevant = (
                    st.session_state[
                        "shopping_relevant"
                    ]
                )
                st.success(
                    f"**{object_name}**"
                )
                st.write(
                    description
                )
                st.write(
                    f"AI confidence: "
                    f"**{confidence * 100:.1f}%**"
                )
                if shopping_relevant:
                    st.success(
                        "? Suitable for visual shopping"
                    )
                    find_products_clicked = st.button(
                        "Find Similar Products",
                        type="primary",
                        use_container_width=True
                    )
                    if find_products_clicked:
                        if not SERPAPI_API_KEY:
                            st.error(
                                "SERPAPI_API_KEY is not configured in .env"
                            )
                        else:
                            with st.spinner(
                                "?? Searching for visually similar products..."
                            ):
                                search_result = search_google_lens(
                                    OUTPUT_DIR / "selected_object.jpg",
                                    SERPAPI_API_KEY,
                                    max_results=12
                                )
                                if not search_result.get("error"):
                                    products = search_result.get(
                                        "results",
                                        []
                                    )
                                    if products:
                                        products = rank_products(
                                            selected_object,
                                            products,
                                            max_products=12
                                        )
                                        search_result["results"] = products
                            if search_result.get("error"):
                                st.error(
                                    search_result["error"]
                                )
                            else:
                                products = search_result.get(
                                    "results",
                                    []
                                )
                                if not products:
                                    st.warning(
                                        "No visual product matches were found."
                                    )
                                else:
                                    st.markdown(
                                        "### Similar Products"
                                    )
                                    for product in products:
                                        title = product.get(
                                            "title",
                                            "Untitled product"
                                        )
                                        source = product.get(
                                            "source",
                                            ""
                                        )
                                        thumbnail = product.get(
                                            "thumbnail",
                                            ""
                                        )
                                        link = product.get(
                                            "link",
                                            ""
                                        )
                                        price = product.get(
                                            "price",
                                            ""
                                        )
                                        currency = product.get(
                                            "currency",
                                            ""
                                        )
                                        col_img, col_info = st.columns(
                                            [1, 2]
                                        )
                                        with col_img:
                                            if thumbnail:
                                                st.image(
                                                    thumbnail,
                                                    use_container_width=True
                                                )
                                        with col_info:
                                            st.markdown(
                                                f"**{title}**"
                                            )
                                            if source:
                                                st.caption(source)
                                            visual_similarity = product.get(
                                                "visual_similarity"
                                            )
                                            if visual_similarity is not None:
                                                visual_score = max(
                                                    0,
                                                    min(
                                                        100,
                                                        visual_similarity * 100
                                                    )
                                                )
                                                st.caption(
                                                    f"Visual Match: "
                                                    f"{visual_score:.1f}%"
                                                )
                                            if price:
                                                if isinstance(price, dict):
                                                    price_text = (
                                                        price.get(
                                                            "value",
                                                            ""
                                                        )
                                                        or price.get(
                                                            "extracted_value",
                                                            ""
                                                        )
                                                    )
                                                else:
                                                    price_text = str(price)
                                                if price_text:
                                                    st.write(
                                                        f"Price: {price_text}"
                                                    )
                                            if link:
                                                st.link_button(
                                                    "View Product",
                                                    link
                                                )
                                        st.markdown("---")
                else:
                    st.warning(
                        "This does not appear to be "
                        "shopping-relevant."
                    )
            # -----------------------------
            # INITIAL STATE
            # -----------------------------
            else:
                st.info(
                    "Click 'Understand Object' "
                    "to analyze your selection."
                )
        st.markdown("---")
        if st.button(
            "🆕 Select Another Object",
            use_container_width=True
        ):
            reset_selection()
            st.rerun()
else:
    st.info(
        "Upload an image above to start."
    )


