import os
import sys
import json
import time
import re
from pathlib import Path

import streamlit as st
from streamlit_drawable_canvas import st_canvas
from PIL import Image
from dotenv import load_dotenv
from google import genai

st.set_page_config(
    page_title="Scene-to-Shop",
    page_icon="🛍️",
    layout="wide",
)

# --------------------------------------------------
# CONFIGURATION
# --------------------------------------------------

BASE_DIR = Path(__file__).resolve().parents[3]
OUTPUT_DIR = BASE_DIR / "vision" / "selection" / "ui_outputs"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

load_dotenv(BASE_DIR / ".env")

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
SERPAPI_API_KEY = os.getenv("SERPAPI_API_KEY")

RETRIEVAL_DIR = BASE_DIR / "vision" / "retrieval" / "search"
if str(RETRIEVAL_DIR) not in sys.path:
    sys.path.insert(0, str(RETRIEVAL_DIR))

from lens_search import search_google_lens, classify_product_link
from visual_ranker import rank_products

MODEL = "gemini-3.6-flash"


# --------------------------------------------------
# SESSION STATE
# --------------------------------------------------

def clear_analysis():
    for key in (
        "object_name",
        "description",
        "confidence",
        "shopping_relevant",
        "analysis_error",
    ):
        st.session_state.pop(key, None)


def reset_selection():
    for key in (
        "selected_object",
        "object_name",
        "description",
        "confidence",
        "shopping_relevant",
        "analysis_error",
        "scene_search_results",
        "scene_search_error",
        "scene_wishlist",
        "scene_compare",
    ):
        st.session_state.pop(key, None)


# --------------------------------------------------
# GEMINI OBJECT UNDERSTANDING
# --------------------------------------------------

def analyze_object(image):
    if not GEMINI_API_KEY:
        return {"error": "GEMINI_API_KEY is not configured in .env."}

    try:
        client = genai.Client(api_key=GEMINI_API_KEY)

        prompt = """
Look carefully at the selected image and identify what is visible.
Do not assume details that cannot be seen.
Return only valid JSON in this format:
{
  "object_name": "specific natural name",
  "description": "short visible description",
  "shopping_relevant": true,
  "confidence": 0.0
}
Confidence must be between 0 and 1.
shopping_relevant must be true only when the object can reasonably
be searched for or purchased.
"""

        response = None

        for attempt in range(3):
            try:
                response = client.models.generate_content(
                    model=MODEL,
                    contents=[prompt, image],
                )
                break
            except Exception as exc:
                message = str(exc)
                if (
                    ("503" in message or "UNAVAILABLE" in message)
                    and attempt < 2
                ):
                    time.sleep(2 ** (attempt + 1))
                    continue
                raise

        if response is None or not response.text:
            return {"error": "Gemini did not return a response."}

        text = response.text.strip()
        if text.startswith("```"):
            text = text.replace("```json", "").replace("```", "").strip()

        return json.loads(text)

    except Exception as exc:
        message = str(exc)
        if "429" in message or "RESOURCE_EXHAUSTED" in message:
            return {"error": "Gemini API quota is exhausted. Try again later."}
        if "503" in message or "UNAVAILABLE" in message:
            return {"error": "Gemini is temporarily busy. Please try again."}
        return {"error": message}


def save_analysis(result):
    st.session_state["object_name"] = result.get(
        "object_name", "Unclear object"
    )
    st.session_state["description"] = result.get("description", "")
    st.session_state["confidence"] = float(result.get("confidence", 0))
    st.session_state["shopping_relevant"] = bool(
        result.get("shopping_relevant", False)
    )
    st.session_state.pop("analysis_error", None)


# --------------------------------------------------
# DARK RESPONSIVE UI
# --------------------------------------------------

st.markdown(
    """
    <style>
    :root {
        color-scheme: dark;
        --bg: #080d19;
        --panel: #111a2c;
        --line: rgba(148,163,184,.22);
        --blue: #3b82f6;
        --cyan: #22d3ee;
    }

    .stApp {
        background:
            radial-gradient(ellipse at 10% 0%,
                rgba(37,99,235,.18), transparent 35%),
            radial-gradient(ellipse at 90% 12%,
                rgba(6,182,212,.10), transparent 30%),
            var(--bg);
        color: #e5edf8;
    }

    [data-testid="stAppViewContainer"] .main .block-container {
        max-width: 1600px;
        padding: 1.5rem 2rem 3rem;
    }

    h1, h2, h3 {
        color: #f8fafc !important;
        letter-spacing: -.03em;
    }

    p, label, [data-testid="stCaptionContainer"] {
        color: #b8c5d9;
    }

    [data-testid="stFileUploader"] {
        background: rgba(17,26,44,.78);
        border: 1px dashed rgba(34,211,238,.58);
        border-radius: 16px;
        padding: 12px;
    }

    [data-testid="stVerticalBlockBorderWrapper"] {
        border-color: var(--line) !important;
        border-radius: 16px !important;
    }

    [data-testid="stImage"] img {
        border-radius: 12px;
        object-fit: contain;
    }

    .stButton > button,
    [data-testid="stLinkButton"] a {
        background: #17243a !important;
        color: #e5edf8 !important;
        border: 1px solid rgba(96,165,250,.4) !important;
        border-radius: 10px !important;
        font-weight: 600 !important;
    }

    .stButton > button[kind="primary"] {
        background: linear-gradient(110deg,#2563eb,#0891b2) !important;
        color: white !important;
        border: 0 !important;
    }

    .stButton > button:hover,
    [data-testid="stLinkButton"] a:hover {
        border-color: var(--cyan) !important;
    }

    /* Scope the responsive grid to the product gallery only. */
    .st-key-scene-product-gallery
    [data-testid="stHorizontalBlock"] {
        display: grid !important;
        grid-template-columns:
            repeat(auto-fit, minmax(min(100%, 220px), 1fr)) !important;
        gap: 1rem !important;
        align-items: stretch !important;
    }

    .st-key-scene-product-gallery
    [data-testid="column"] {
        width: auto !important;
        min-width: 0 !important;
        flex: unset !important;
    }

    .st-key-scene-product-gallery
    [data-testid="stVerticalBlockBorderWrapper"] {
        height: 100%;
        background: rgba(17,26,44,.82);
        padding: .75rem;
    }

    .st-key-scene-product-gallery [data-testid="stImage"] img {
        height: 190px;
        width: 100%;
        object-fit: contain;
        background: rgba(8,13,25,.5);
    }

    @media (max-width: 768px) {
        [data-testid="stAppViewContainer"] .main .block-container {
            padding: 1rem .8rem 2rem;
        }

        .st-key-scene-product-gallery
        [data-testid="stHorizontalBlock"] {
            grid-template-columns:
                repeat(auto-fit, minmax(min(100%, 155px), 1fr)) !important;
        }
    }

    @media (max-width: 380px) {
        .st-key-scene-product-gallery
        [data-testid="stHorizontalBlock"] {
            grid-template-columns: minmax(0, 1fr) !important;
        }
    }

    hr {
        border-color: var(--line);
    }
    </style>
    """,
    unsafe_allow_html=True,
)


# --------------------------------------------------
# PAGE HEADER
# --------------------------------------------------

st.title("🛍️ Scene-to-Shop")
st.subheader("Select anything you want to shop for")
st.write("Upload a scene, select an object, and let AI understand it.")

uploaded_file = st.file_uploader(
    "Upload an image",
    type=["jpg", "jpeg", "png"],
    key="scene_upload",
)


# --------------------------------------------------
# IMAGE UPLOAD AND OBJECT SELECTION
# --------------------------------------------------

if uploaded_file:
    image = Image.open(uploaded_file).convert("RGB")

    st.markdown("### 1. Upload and select an object")
    st.caption(
        "Draw a rectangle around the item you want to find. "
        "Select the object as accurately as possible."
    )

    canvas_width = min(1000, image.width)
    scale = canvas_width / image.width
    canvas_height = int(image.height * scale)

    display_image = image.resize((canvas_width, canvas_height))

    canvas_result = st_canvas(
        fill_color="rgba(0, 200, 255, 0.20)",
        stroke_width=4,
        stroke_color="#22d3ee",
        background_image=display_image,
        update_streamlit=True,
        height=canvas_height,
        width=canvas_width,
        drawing_mode="rect",
        key="object_selector",
    )

    action_col1, action_col2 = st.columns(2)

    with action_col1:
        understand_clicked = st.button(
            "🔍 Understand Object",
            type="primary",
            use_container_width=True,
        )

    with action_col2:
        retry_selection_clicked = st.button(
            "↩ Retry Selection",
            use_container_width=True,
        )

    if retry_selection_clicked:
        reset_selection()
        st.rerun()

    if understand_clicked:
        objects = (
            canvas_result.json_data.get("objects", [])
            if canvas_result.json_data
            else []
        )

        if not objects:
            st.warning("Please draw a rectangle around an object first.")
        else:
            rect = objects[-1]
            left = rect.get("left", 0)
            top = rect.get("top", 0)
            width = rect.get("width", 0)
            height = rect.get("height", 0)

            if width < 15 or height < 15:
                st.warning("The selected area is too small.")
            else:
                scale_x = image.width / canvas_width
                scale_y = image.height / canvas_height

                x1 = max(0, int(left * scale_x))
                y1 = max(0, int(top * scale_y))
                x2 = min(image.width, int((left + width) * scale_x))
                y2 = min(image.height, int((top + height) * scale_y))

                pad_x = int((x2 - x1) * 0.15)
                pad_y = int((y2 - y1) * 0.15)

                selected = image.crop(
                    (
                        max(0, x1 - pad_x),
                        max(0, y1 - pad_y),
                        min(image.width, x2 + pad_x),
                        min(image.height, y2 + pad_y),
                    )
                )

                selected_path = OUTPUT_DIR / "selected_object.jpg"
                selected.save(selected_path, quality=95)

                st.session_state["selected_object"] = selected
                clear_analysis()
                st.session_state.pop("scene_search_results", None)
                st.session_state.pop("scene_search_error", None)

                with st.spinner("AI is understanding the selected object..."):
                    result = analyze_object(selected)

                if "error" in result:
                    st.session_state["analysis_error"] = result["error"]
                else:
                    save_analysis(result)

                st.rerun()


# --------------------------------------------------
# AI UNDERSTANDING
# --------------------------------------------------

if "selected_object" in st.session_state:
    st.markdown("---")
    st.markdown("### 2. AI Understanding")

    selected_object = st.session_state["selected_object"]

    image_col, details_col = st.columns([0.8, 1.2], gap="large")

    with image_col:
        st.image(
            selected_object,
            caption="Selected object",
            width="stretch",
        )

    with details_col:
        if "analysis_error" in st.session_state:
            st.warning("AI understanding is temporarily unavailable.")
            st.write(st.session_state["analysis_error"])

            if st.button("🔄 Retry AI Analysis", type="primary"):
                clear_analysis()

                with st.spinner("Trying AI analysis again..."):
                    result = analyze_object(selected_object)

                if "error" in result:
                    st.session_state["analysis_error"] = result["error"]
                else:
                    save_analysis(result)

                st.rerun()

        elif "object_name" in st.session_state:
            st.success(f"**{st.session_state['object_name']}**")
            st.write(st.session_state.get("description", ""))

            confidence = st.session_state.get("confidence", 0)
            st.caption(f"AI confidence: {confidence * 100:.1f}%")

            if st.session_state.get("shopping_relevant", False):
                st.success("Suitable for visual shopping")

                if st.button(
                    "🛍️ Find Similar Products",
                    type="primary",
                    use_container_width=True,
                    key="find_similar_products",
                ):
                    if not SERPAPI_API_KEY:
                        st.session_state["scene_search_error"] = (
                            "SERPAPI_API_KEY is not configured in .env."
                        )
                        st.session_state.pop("scene_search_results", None)
                    else:
                        with st.spinner(
                            "Searching for visually similar products..."
                        ):
                            search_result = search_google_lens(
                                OUTPUT_DIR / "selected_object.jpg",
                                SERPAPI_API_KEY,
                                max_results=12,
                            )

                            if not search_result.get("error"):
                                products_found = search_result.get("results", [])

                                if products_found:
                                    products_found = rank_products(
                                        selected_object,
                                        products_found,
                                        max_products=12,
                                    )

                                search_result["results"] = products_found

                        if search_result.get("error"):
                            st.session_state["scene_search_error"] = (
                                search_result["error"]
                            )
                            st.session_state.pop("scene_search_results", None)
                        else:
                            st.session_state["scene_search_results"] = (
                                search_result.get("results", [])
                            )
                            st.session_state.pop("scene_search_error", None)
                            st.session_state["scene_wishlist"] = []
                            st.session_state["scene_compare"] = []

                    st.rerun()
        else:
            st.info("Click 'Understand Object' to analyze your selection.")


# --------------------------------------------------
# FULL-WIDTH SHOPPING RESULTS
# --------------------------------------------------

if st.session_state.get("scene_search_error"):
    st.error(st.session_state["scene_search_error"])

products = st.session_state.get("scene_search_results", [])

if products:
    st.markdown("---")
    st.markdown("### 🛍️ Shopping Results")
    st.caption(
        f"{len(products)} visual matches. "
        "Prices and availability depend on the original listing."
    )

    st.session_state.setdefault("scene_wishlist", [])
    st.session_state.setdefault("scene_compare", [])

    sort_mode = st.selectbox(
        "Sort products",
        [
            "Best visual match",
            "Highest listing quality",
            "Lowest price",
        ],
        key="scene_product_sort",
    )

    def price_value(item):
        value = item.get("price", "")

        if isinstance(value, dict):
            value = (
                value.get("value")
                or value.get("extracted_value")
                or value.get("raw")
                or ""
            )

        match = re.search(r"\d[\d,]*(?:\.\d+)?", str(value or ""))

        if not match:
            return None

        try:
            return float(match.group(0).replace(",", ""))
        except ValueError:
            return None

    display_products = list(products)

    if sort_mode == "Best visual match":
        display_products.sort(
            key=lambda p: float(
                p.get("relevance_score")
                if p.get("relevance_score") is not None
                else -1
            ),
            reverse=True,
        )
    elif sort_mode == "Highest listing quality":
        display_products.sort(
            key=lambda p: float(
                p.get("listing_quality")
                if p.get("listing_quality") is not None
                else -1
            ),
            reverse=True,
        )
    else:
        display_products.sort(
            key=lambda p: (
                price_value(p) is None,
                price_value(p) if price_value(p) is not None else float("inf"),
            )
        )

    # Four Streamlit columns per row; CSS above adapts their visible widths.
    with st.container(key="scene-product-gallery"):
        for start in range(0, len(display_products), 4):
            row_products = display_products[start:start + 4]
            columns = st.columns(4, gap="medium")

            for offset, product in enumerate(row_products):
                index = start + offset

                with columns[offset]:
                    title = str(product.get("title") or "Untitled product")
                    source = str(product.get("source") or "")
                    thumbnail = product.get("thumbnail") or ""
                    link = product.get("link") or ""
                    price = product.get("price", "")
                    currency = product.get("currency") or ""

                    if isinstance(price, dict):
                        currency = price.get("currency") or currency
                        price_text = (
                            price.get("value")
                            or price.get("extracted_value")
                            or price.get("raw")
                            or ""
                        )
                    else:
                        price_text = str(price or "")

                    product_key = (
                        str(product.get("product_id") or "")
                        or link
                        or f"{title}_{index}"
                    )[:180]

                    with st.container(border=True):
                        if thumbnail:
                            st.image(thumbnail, width="stretch")
                        else:
                            st.markdown(
                                '<div style="height:190px;display:flex;'
                                'align-items:center;justify-content:center;'
                                'background:#111a2c;border-radius:10px;">'
                                'Image unavailable</div>',
                                unsafe_allow_html=True,
                            )

                        st.markdown(
                            f"**{title[:115]}**"
                            + ("…" if len(title) > 115 else "")
                        )

                        if source:
                            st.caption(source)

                        if price_text:
                            st.markdown(f"### {currency} {price_text}".strip())
                        else:
                            st.caption("Price unavailable")

                        score = product.get("relevance_score")
                        if score is not None:
                            st.caption(f"Visual match: {score:.3f}")

                        quality = product.get("listing_quality")
                        if quality is not None:
                            st.caption(
                                "Stronger listing signals"
                                if quality >= 0.60
                                else "Verify listing before buying"
                            )

                        link_info = (
                            classify_product_link(
                                link,
                                title=title,
                                source=source,
                            )
                            if link
                            else {"valid_url": False}
                        )

                        if link_info.get("valid_url"):
                            label = (
                                "View Product"
                                if link_info.get("likely_product_page")
                                else "Open Result"
                            )
                            st.link_button(label, link, width="stretch")
                        else:
                            st.button(
                                "Link unavailable",
                                key=f"no_link_{index}",
                                disabled=True,
                                width="stretch",
                            )

                        saved = product_key in st.session_state["scene_wishlist"]

                        if st.button(
                            "✓ Saved" if saved else "♡ Wishlist",
                            key=f"wishlist_{index}",
                            width="stretch",
                        ):
                            items = st.session_state["scene_wishlist"]

                            if product_key in items:
                                items.remove(product_key)
                            else:
                                items.append(product_key)

                            st.rerun()

                        compared = product_key in st.session_state["scene_compare"]

                        if st.button(
                            "✓ Compared" if compared else "＋ Compare",
                            key=f"compare_{index}",
                            width="stretch",
                        ):
                            items = st.session_state["scene_compare"]

                            if product_key in items:
                                items.remove(product_key)
                            elif len(items) < 4:
                                items.append(product_key)
                            else:
                                st.warning("Compare up to four products.")

                            st.rerun()

    # --------------------------------------------------
    # COMPARE SELECTED PRODUCTS
    # --------------------------------------------------

    selected_keys = st.session_state["scene_compare"]

    if selected_keys:
        st.markdown("### Compare Selection")

        lookup = {}

        for index, item in enumerate(display_products):
            key = (
                str(item.get("product_id") or "")
                or str(item.get("link") or "")
                or f"{item.get('title', 'Untitled')}_{index}"
            )[:180]
            lookup[key] = item

        compare_items = [
            lookup[key] for key in selected_keys if key in lookup
        ]

        compare_columns = st.columns(
            max(1, min(len(compare_items), 4)),
            gap="medium",
        )

        for column, item in zip(compare_columns, compare_items):
            with column:
                st.markdown(
                    f"**{str(item.get('title') or 'Untitled')[:100]}**"
                )

                item_price = item.get("price", "")
                if isinstance(item_price, dict):
                    item_price = (
                        item_price.get("value")
                        or item_price.get("extracted_value")
                        or item_price.get("raw")
                        or ""
                    )

                st.write(f"Price: {item_price or 'Unavailable'}")
                st.write(
                    "Visual match: "
                    + str(item.get("relevance_score", "Unavailable"))
                )

    if st.session_state["scene_wishlist"]:
        st.markdown("### ♡ Wishlist")
        st.caption(
            f"{len(st.session_state['scene_wishlist'])} product(s) saved "
            "for this session."
        )


# --------------------------------------------------
# START OVER
# --------------------------------------------------

if "selected_object" in st.session_state:
    st.markdown("---")

    if st.button("🆕 Select Another Object", use_container_width=True):
        reset_selection()
        st.rerun()
elif not uploaded_file:
    st.info("Upload an image above to start.")