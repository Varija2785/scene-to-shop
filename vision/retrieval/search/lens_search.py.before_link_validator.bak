from pathlib import Path
import requests
def search_google_lens(image_path, api_key, max_results=12):
    if not api_key:
        return {
            "error": "SERPAPI_API_KEY is not configured.",
            "results": []
        }
    image_path = Path(image_path)
    if not image_path.exists():
        return {
            "error": f"Image not found: {image_path}",
            "results": []
        }
    try:
        # --------------------------------------------------
        # STEP 1: Upload image
        # --------------------------------------------------
        image_size = image_path.stat().st_size
        if image_size > 500 * 1024:
            return {
                "error": (
                    "Selected image is larger than "
                    "SerpApi's 500 KB upload limit."
                ),
                "results": []
            }
        with open(image_path, "rb") as image_file:
            upload_response = requests.post(
                "https://serpapi.com/image",
                params={
                    "api_key": api_key
                },
                files={
                    "image": (
                        image_path.name,
                        image_file,
                        "image/jpeg"
                    )
                },
                timeout=60
            )
        if not upload_response.ok:
            return {
                "error": (
                    "SerpApi image upload failed "
                    f"(HTTP {upload_response.status_code}): "
                    f"{upload_response.text[:500]}"
                ),
                "results": []
            }
        upload_result = upload_response.json()
        if "error" in upload_result:
            return {
                "error": (
                    f"SerpApi upload error: "
                    f"{upload_result['error']}"
                ),
                "results": []
            }
        image_id = upload_result.get("image_id")
        if not image_id:
            return {
                "error": (
                    "SerpApi did not return image_id."
                ),
                "results": []
            }
        # --------------------------------------------------
        # STEP 2: Google Lens
        # --------------------------------------------------
        search_response = requests.get(
            "https://serpapi.com/search.json",
            params={
                "engine": "google_lens",
                "image_id": image_id,
                "type": "visual_matches",
                "hl": "en",
                "country": "in",
                "api_key": api_key
            },
            timeout=60
        )
        if not search_response.ok:
            return {
                "error": (
                    "Google Lens search failed "
                    f"(HTTP {search_response.status_code}): "
                    f"{search_response.text[:500]}"
                ),
                "results": []
            }
        results_data = search_response.json()
        if "error" in results_data:
            return {
                "error": results_data["error"],
                "results": []
            }
        visual_matches = results_data.get(
            "visual_matches",
            []
        )
        results = []
        for item in visual_matches[:max_results]:
            product = dict(item)
            product["title"] = item.get("title") or "Untitled product"
            product["link"] = item.get("link") or ""
            product["source"] = item.get("source") or ""
            product["thumbnail"] = item.get("thumbnail") or ""
            product["price"] = item.get("price") or ""
            product["currency"] = item.get("currency") or ""
            results.append(product)
        return {
            "error": None,
            "results": results
        }
    except requests.RequestException as e:
        return {
            "error": (
                "Network error while searching Google Lens: "
                f"{e}"
            ),
            "results": []
        }
    except Exception as e:
        return {
            "error": (
                "Google Lens search failed: "
                f"{e}"
            ),
            "results": []
        }
