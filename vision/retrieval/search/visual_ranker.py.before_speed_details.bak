from functools import lru_cache
import requests
import numpy as np
import torch
from PIL import Image
from io import BytesIO
from transformers import CLIPProcessor, CLIPModel
MODEL_NAME = "openai/clip-vit-base-patch32"
@lru_cache(maxsize=1)
def load_clip():
    print("Loading CLIP model...")
    model = CLIPModel.from_pretrained(MODEL_NAME)
    processor = CLIPProcessor.from_pretrained(MODEL_NAME)
    model.eval()
    return model, processor
def image_embedding(image):
    model, processor = load_clip()
    inputs = processor(
        images=image,
        return_tensors="pt"
    )
    with torch.no_grad():
        output = model.get_image_features(**inputs)
    # Transformers may return a BaseModelOutputWithPooling
    # instead of a raw tensor.
    if hasattr(output, "pooler_output"):
        features = output.pooler_output
    elif hasattr(output, "last_hidden_state"):
        features = output.last_hidden_state[:, 0, :]
    else:
        features = output
    # Make sure we have a tensor.
    if not isinstance(features, torch.Tensor):
        raise TypeError(
            f"Unexpected CLIP output type: {type(features)}"
        )
    # L2 normalize the embedding.
    features = features / features.norm(
        dim=-1,
        keepdim=True
    ).clamp(min=1e-12)
    return features[0].cpu().numpy()
def cosine_similarity(a, b):
    a = np.asarray(a, dtype=np.float32)
    b = np.asarray(b, dtype=np.float32)
    denominator = (
        np.linalg.norm(a) *
        np.linalg.norm(b)
    )
    if denominator == 0:
        return 0.0
    return float(np.dot(a, b) / denominator)
def download_product_image(url):
    if not url:
        return None
    try:
        response = requests.get(
            url,
            timeout=15,
            headers={
                "User-Agent": (
                    "Mozilla/5.0 "
                    "(Windows NT 10.0; Win64; x64) "
                    "AppleWebKit/537.36 "
                    "(KHTML, like Gecko) "
                    "Chrome/154.0.0.0 Safari/537.36"
                )
            }
        )
        response.raise_for_status()
        return Image.open(
            BytesIO(response.content)
        ).convert("RGB")
    except Exception as e:
        print(
            f"Could not download product image: "
            f"{e}"
        )
        return None
def rank_products(
    selected_image,
    products,
    max_products=12
):
    if not products:
        return []
    print(
        f"Ranking up to {min(len(products), max_products)} "
        f"products with CLIP..."
    )
    query_embedding = image_embedding(
        selected_image
    )
    ranked = []
    for product in products[:max_products]:
        thumbnail = product.get(
            "thumbnail",
            ""
        )
        product_image = download_product_image(
            thumbnail
        )
        if product_image is None:
            product["visual_similarity"] = None
            ranked.append(product)
            continue
        try:
            product_embedding = image_embedding(
                product_image
            )
            similarity = cosine_similarity(
                query_embedding,
                product_embedding
            )
            product["visual_similarity"] = similarity
            print(
                f"  {product.get('title', 'Product')[:60]} "
                f"-> {similarity:.4f}"
            )
        except Exception as e:
            print(
                f"CLIP failed for product: {e}"
            )
            product["visual_similarity"] = None
        ranked.append(product)
    # Products with a valid visual score first,
    # highest similarity first.
    ranked.sort(
        key=lambda item: (
            item.get("visual_similarity") is not None,
            item.get("visual_similarity") or -1
        ),
        reverse=True
    )
    return ranked
